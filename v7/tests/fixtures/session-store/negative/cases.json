      "workspace": {
        "schemaVersion": 3,
        "state": "configured",
        "paneLayout": {},
        "replayNavigationSettings": {}
      }
    },
    "expectedCode": "INVALID_SESSION_WORKSPACE"
  },
  {
    "name": "invalid layout sync workspace",
    "operation": "deserialize",
    "patch": {
      "workspace": {
        "schemaVersion": 5,
        "state": "configured",
        "paneLayout": {},
        "layoutSync": {}
      }
    },
    "expectedCode": "INVALID_SESSION_WORKSPACE"
  },
  {
    "name": "unknown session",
    "operation": "getUnknown",
    "patch": {},
    "expectedCode": "SESSION_NOT_FOUND"
  },
  {
    "name": "delete unknown session",
    "operation": "deleteUnknown",
    "patch": {},
    "expectedCode": "SESSION_NOT_FOUND"
  },
  {
