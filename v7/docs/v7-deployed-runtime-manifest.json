{
  "schemaVersion": 2,
  "status": "standalone-v7",
  "productionRoots": [
    { "path": "v7/server", "extensions": [".py"] },
    { "path": "v7/scripts", "extensions": [".mjs"] },
    { "path": "v7/deploy/linux", "extensions": [".sh", ".template", ".txt", ".md"] }
  ],
  "releaseContract": {
    "repositoryArchiveRoots": ["v7"],
    "marketDatabase": {
      "delivery": "external-file",
      "environmentVariable": "V7_MARKET_DATA_DB",
      "releaseContainsDatabase": false
    }
  },
  "components": [
    {
      "id": "service.v7-web",
      "kind": "service",
      "owner": "web-delivery",
      "entry": "v7/scripts/serve.mjs",
      "ownedPaths": [
        "v7/scripts/serve.mjs",
        "v7/scripts/static-server.mjs",
        "v7/scripts/state-proxy.mjs",
        "v7/scripts/database-import-proxy.mjs"
      ],
      "requiredComponents": [
        "service.v7-market-data"
      ],
      "optionalComponents": [
        "service.v7-state",
        "service.v7-database-import"
      ],
      "writerSurfaces": [],
      "independentHarnesses": [
        "v7/tests/static-server-public-surface-harness.js",
        "v7/tests/production-application-host-browser-harness.js"
      ]
    },
    {
      "id": "service.v7-state",
      "kind": "service",
      "owner": "replicated-user-state",
      "entry": "v7/server/state_api.py",
      "ownedPaths": ["v7/server/state_api.py", "v7/server/state_store.py"],
      "requiredComponents": [],
      "optionalComponents": [],
      "writerSurfaces": ["userStateSqlite"],
      "independentHarnesses": ["v7/tests/state-service-harness.js"]
    },
    {
      "id": "library.v7-duckdb-runtime",
      "kind": "library",
      "owner": "bounded-duckdb-resources",
      "entry": "v7/server/duckdb_runtime.py",
      "ownedPaths": ["v7/server/duckdb_runtime.py"],
      "requiredComponents": [],
      "optionalComponents": [],
      "writerSurfaces": [],
      "independentHarnesses": ["v7/tests/resource-profile-harness.js"]
    },
    {
      "id": "service.v7-database-import",
      "kind": "service",
      "owner": "first-database-import",
      "entry": "v7/server/database_import_api.py",
      "ownedPaths": [
        "v7/server/database_import_api.py",
        "v7/server/database_import_store.py",
        "v7/server/database_import_validation.py"
      ],
      "requiredComponents": ["library.v7-duckdb-runtime"],
      "optionalComponents": [],
      "writerSurfaces": [
        "databaseImportStaging",
        "marketDatabaseActivation",
        "marketDatabaseActivationLock"
      ],
      "independentHarnesses": ["v7/tests/database-import-service-harness.js"]
    },
    {
      "id": "service.v7-market-data",
      "kind": "read-only-service",
      "owner": "v7-market-data-read-boundary",
      "entry": "v7/server/market_data_api.py",
      "ownedPaths": [
        "v7/server/market_data_api.py",
        "v7/server/market_data_economic_calendar.py",
        "v7/server/market_data_queries.py",
        "v7/server/market_data_read_handler.py",
        "v7/server/market_data_revision.py"
      ],
      "requiredComponents": ["library.v7-duckdb-runtime"],
      "optionalComponents": [],
      "writerSurfaces": [],
      "independentHarnesses": ["v7/tests/market-data-service-harness.js"]
    },
    {
      "id": "deployment.linux",
      "kind": "deployment",
      "owner": "linux-host-transaction",
      "entry": "v7/deploy/linux/install.sh",
      "ownedPaths": ["v7/deploy/linux/"],
      "requiredComponents": [
        "service.v7-market-data",
        "service.v7-web",
        "service.v7-state",
        "service.v7-database-import"
      ],
      "optionalComponents": [],
      "writerSurfaces": [
        "databaseFileMetadata",
        "hostCapacityConfiguration",
        "hostServiceConfiguration",
        "proxyConfiguration",
        "releaseFilesystem"
      ],
      "independentHarnesses": [
        "v7/tests/linux-deployment-script-harness.js",
        "v7/tests/linux-host-transaction-harness.js",
        "v7/tests/standalone-v7-runtime-harness.js"
      ]
    },
    {
      "id": "tooling.v7-architecture-baseline",
      "kind": "tooling",
      "owner": "architecture-governance",
      "entry": "v7/scripts/refresh-production-architecture-baseline.mjs",
      "ownedPaths": [
        "v7/scripts/refresh-production-architecture-baseline.mjs",
        "v7/scripts/refresh-production-source-quality-baseline.mjs"
      ],
      "requiredComponents": [],
      "optionalComponents": [],
      "writerSurfaces": ["architectureBaseline", "sourceQualityBaseline"],
      "independentHarnesses": [
        "v7/tests/production-architecture-harness.js",
        "v7/tests/source-quality-harness.js"
      ]
    }
  ],
  "serviceUnitDirectory": "v7/deploy/linux/systemd",
  "serviceUnits": [
    {
      "component": "service.v7-market-data",
      "listenEndpoint": "127.0.0.1:8766",
      "listenEvidence": {
        "path": "v7/deploy/linux/install.sh",
        "text": "V7_MARKET_DATA_PORT=8766"
      },
      "template": "v7/deploy/linux/systemd/replay-lab-market-data.service.template",
      "unitName": "replay-lab-market-data.service"
    },
    {
      "component": "service.v7-state",
      "listenEndpoint": "127.0.0.1:8767",
      "listenEvidence": {
        "path": "v7/deploy/linux/install.sh",
        "text": "V7_STATE_PORT=8767"
      },
      "template": "v7/deploy/linux/systemd/replay-lab-state.service.template",
      "unitName": "replay-lab-state.service"
    },
    {
      "component": "service.v7-database-import",
      "listenEndpoint": "127.0.0.1:8768",
      "listenEvidence": {
        "path": "v7/deploy/linux/install.sh",
        "text": "V7_DATABASE_IMPORT_PORT=8768"
      },
      "template": "v7/deploy/linux/systemd/replay-lab-database-import.service.template",
      "unitName": "replay-lab-database-import.service"
    },
    {
      "component": "service.v7-web",
      "listenEndpoint": "127.0.0.1:8007",
      "listenEvidence": {
        "path": "v7/deploy/linux/systemd/replay-lab-web.service.template",
        "text": "serve.mjs 8007"
      },
      "template": "v7/deploy/linux/systemd/replay-lab-web.service.template",
      "unitName": "replay-lab-web.service"
    }
  ],
  "proxyConfigurationPaths": [
    "v7/deploy/linux/caddy/Caddyfile.template",
    "v7/deploy/linux/install.sh"
  ],
  "proxyRoutes": [
    {
      "activation": "always",
      "configurationPath": "v7/deploy/linux/caddy/Caddyfile.template",
      "id": "caddy.v7-market-data",
      "matcher": "@market_data",
      "pathPattern": "/v7/market-data/*",
      "sourceComponent": "deployment.linux",
      "targetComponent": "service.v7-market-data",
      "targetEndpoint": "127.0.0.1:8766"
    },
    {
      "activation": "authenticated",
      "configurationPath": "v7/deploy/linux/install.sh",
      "id": "caddy.v7-state",
      "matcher": "@state_api",
      "pathPattern": "/v7/state/*",
      "sourceComponent": "deployment.linux",
      "targetComponent": "service.v7-state",
      "targetEndpoint": "127.0.0.1:8767"
    },
    {
      "activation": "authenticated-bootstrap",
      "configurationPath": "v7/deploy/linux/install.sh",
      "id": "caddy.v7-database-import",
      "matcher": "@database_import",
      "pathPattern": "/v7/database/*",
      "sourceComponent": "deployment.linux",
      "targetComponent": "service.v7-database-import",
      "targetEndpoint": "127.0.0.1:8768"
    },
    {
      "activation": "always",
      "configurationPath": "v7/deploy/linux/caddy/Caddyfile.template",
      "id": "caddy.v7-web",
      "matcher": null,
      "pathPattern": "/*",
      "sourceComponent": "deployment.linux",
      "targetComponent": "service.v7-web",
      "targetEndpoint": "127.0.0.1:8007"
    }
  ],
  "crossRuntimeSmokes": [
    {
      "capability": "read-only-boundary",
      "component": "service.v7-market-data",
      "path": "v7/tests/market-data-service-harness.js",
      "runtime": "node",
      "successText": "v7 market-data service harness passed"
    },
    {
      "capability": "dataset-revision",
      "component": "service.v7-market-data",
      "path": "v7/tests/market-data-service-harness.js",
      "runtime": "node",
      "successText": "v7 market-data service harness passed"
    }
  ],
  "writerInventories": {
    "architectureBaseline": "tooling.v7-architecture-baseline",
    "databaseFileMetadata": "deployment.linux",
    "databaseImportStaging": "service.v7-database-import",
    "hostCapacityConfiguration": "deployment.linux",
    "hostServiceConfiguration": "deployment.linux",
    "marketDatabaseActivation": "service.v7-database-import",
    "marketDatabaseActivationLock": "service.v7-database-import",
    "proxyConfiguration": "deployment.linux",
    "releaseFilesystem": "deployment.linux",
    "sourceQualityBaseline": "tooling.v7-architecture-baseline",
    "userStateSqlite": "service.v7-state"
  },
  "writerEvidence": [
    { "surface": "architectureBaseline", "path": "v7/scripts/refresh-production-architecture-baseline.mjs", "pattern": "writeFileSync" },
    { "surface": "databaseFileMetadata", "path": "v7/deploy/linux/deploy.sh", "pattern": "chown root:" },
    { "surface": "databaseImportStaging", "path": "v7/server/database_import_store.py", "pattern": "staging_root" },
    { "surface": "hostCapacityConfiguration", "path": "v7/deploy/linux/lib/resource-profile.sh", "pattern": "/etc/fstab" },
    { "surface": "hostServiceConfiguration", "path": "v7/deploy/linux/install.sh", "pattern": "/etc/systemd/system" },
    { "surface": "marketDatabaseActivation", "path": "v7/server/database_import_store.py", "pattern": "os.link" },
    { "surface": "marketDatabaseActivationLock", "path": "v7/server/database_import_store.py", "pattern": "activation_lock" },
    { "surface": "proxyConfiguration", "path": "v7/deploy/linux/install.sh", "pattern": "/etc/caddy/Caddyfile" },
    { "surface": "releaseFilesystem", "path": "v7/deploy/linux/install.sh", "pattern": "current.next" },
    { "surface": "sourceQualityBaseline", "path": "v7/scripts/refresh-production-source-quality-baseline.mjs", "pattern": "writeFileSync" },
    { "surface": "userStateSqlite", "path": "v7/server/state_store.py", "pattern": "BEGIN IMMEDIATE" }
  ]
}
