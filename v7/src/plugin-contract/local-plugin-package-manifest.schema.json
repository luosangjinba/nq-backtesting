{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://replay-lab.local/schemas/local-plugin-package-manifest-v2.schema.json",
  "title": "PluginPackageManifestV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion", "packageId", "packageVersion", "display", "publisher",
    "license", "hostApiRange", "contractProfile", "capabilities", "contributions",
    "settings", "permissions", "execution", "persistence", "conformance"
  ],
  "properties": {
    "manifestVersion": { "const": 2 },
    "packageId": { "$ref": "#/$defs/localId" },
    "packageVersion": { "$ref": "#/$defs/version" },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 96 },
        "description": { "type": "string", "minLength": 1, "maxLength": 320 }
      }
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "$ref": "#/$defs/localId" },
        "name": { "type": "string", "minLength": 1, "maxLength": 96 }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expression", "noticePath"],
      "properties": {
        "expression": { "type": "string", "minLength": 1, "maxLength": 160 },
        "noticePath": { "$ref": "#/$defs/path" }
      }
    },
    "hostApiRange": { "$ref": "#/$defs/range" },
    "contractProfile": { "const": "local-declarative-package-v1" },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provides", "requires", "extends"],
      "properties": {
        "provides": { "type": "array", "maxItems": 0 },
        "requires": { "type": "array", "maxItems": 0 },
        "extends": { "type": "array", "maxItems": 0 }
      }
    },
    "contributions": { "type": "array", "maxItems": 0 },
    "settings": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/localSettings" }
      ]
    },
    "permissions": { "type": "array", "maxItems": 0 },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier", "entrypoint"],
      "properties": {
        "tier": { "const": "none" },
        "entrypoint": { "type": "null" }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "retention", "migrations"],
      "properties": {
        "schemaVersion": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "retention": { "const": "preserve-on-uninstall" },
        "migrations": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/migration" }
        }
      }
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sdkVersion", "toolchainDigest", "requiredReceiptDigests"],
      "properties": {
        "sdkVersion": { "$ref": "#/$defs/version" },
        "toolchainDigest": { "$ref": "#/$defs/digest" },
        "requiredReceiptDigests": {
          "oneOf": [
            { "type": "array", "maxItems": 0 },
            {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/digest" }
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "localId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^(?!(?:built-in|first-party|core)\\.)[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\/$)(?!(?:content-index\\.json|v7-package\\.json|v7dk\\.bundle\\.json|v7dk\\.index\\.json|payload|provenance|receipts)(?:/|$))[A-Za-z0-9._/-]+$"
    },
    "settingPointer": { "type": "string", "pattern": "^/(?:packageValues|profileValues)/[a-z][A-Za-z0-9.-]{0,63}$" },
    "settingOrNullPointer": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/settingPointer" }
      ]
    },
    "quarantinePointer": { "type": "string", "pattern": "^/quarantine/[a-z][A-Za-z0-9.-]{0,63}$" },
    "version": { "type": "string", "maxLength": 50, "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "range": { "type": "string", "maxLength": 51, "pattern": "^\\^?(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "localSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "tabs"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "tabs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "source"],
            "properties": {
              "id": { "enum": ["inputs", "style", "visibility"] },
              "source": {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "fields"],
                "properties": {
                  "kind": { "const": "settings" },
                  "fields": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 32,
                    "items": { "$ref": "#/$defs/localSettingField" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "localSettingField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "scopes", "defaultValue", "control"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][A-Za-z0-9.-]{0,63}$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 96 },
        "scopes": {
          "type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true,
          "items": { "enum": ["package", "profile"] }
        },
        "defaultValue": {},
        "control": {
          "oneOf": [
            {
              "type": "object", "additionalProperties": false, "required": ["kind"],
              "properties": { "kind": { "enum": ["boolean", "color"] } }
            },
            {
              "type": "object", "additionalProperties": false, "required": ["kind", "min", "max", "step"],
              "properties": {
                "kind": { "const": "number" }, "min": { "type": "number" },
                "max": { "type": "number" }, "step": { "type": "number", "exclusiveMinimum": 0 }
              }
            },
            {
              "type": "object", "additionalProperties": false, "required": ["kind", "maxLength"],
              "properties": { "kind": { "const": "text" }, "maxLength": { "type": "integer", "minimum": 1, "maximum": 512 } }
            },
            {
              "type": "object", "additionalProperties": false, "required": ["kind", "options"],
              "properties": {
                "kind": { "const": "select" },
                "options": {
                  "type": "array", "minItems": 1, "maxItems": 64,
                  "items": {
                    "type": "object", "additionalProperties": false, "required": ["label", "value"],
                    "properties": {
                      "label": { "type": "string", "minLength": 1, "maxLength": 80 },
                      "value": { "type": "string", "minLength": 1, "maxLength": 80 }
                    }
                  }
                }
              }
            }
          ]
        }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fromSchemaVersion", "toSchemaVersion", "operations", "expectedOutputDigest"],
      "properties": {
        "fromSchemaVersion": { "type": "integer", "minimum": 1 },
        "toSchemaVersion": { "type": "integer", "minimum": 2 },
        "expectedOutputDigest": { "$ref": "#/$defs/digest" },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": { "$ref": "#/$defs/migrationOperation" }
        }
      }
    },
    "migrationOperation": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "fromPointer", "toPointer", "value", "precondition"],
          "properties": {
            "kind": { "enum": ["rename", "copy-if-absent"] },
            "fromPointer": { "$ref": "#/$defs/settingPointer" },
            "toPointer": { "$ref": "#/$defs/settingPointer" },
            "value": { "type": "null" },
            "precondition": { "const": "source-present-destination-absent" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "fromPointer", "toPointer", "value", "precondition"],
          "properties": {
            "kind": { "const": "set-default-if-absent" },
            "fromPointer": { "type": "null" },
            "toPointer": { "$ref": "#/$defs/settingPointer" },
            "value": { "$ref": "#/$defs/nonNullPortableValue" },
            "precondition": { "const": "destination-absent" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "fromPointer", "toPointer", "value", "precondition"],
          "properties": {
            "kind": { "const": "quarantine-field" },
            "fromPointer": { "$ref": "#/$defs/settingPointer" },
            "toPointer": { "$ref": "#/$defs/quarantinePointer" },
            "value": { "type": "null" },
            "precondition": { "const": "source-present" }
          }
        }
      ]
    },
    "portableValue": {
      "oneOf": [
        { "type": "null" }, { "type": "boolean" }, { "type": "number" }, { "type": "string" },
        { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/portableValue" } },
        { "type": "object", "maxProperties": 128, "additionalProperties": { "$ref": "#/$defs/portableValue" } }
      ]
    },
    "nonNullPortableValue": {
      "oneOf": [
        { "type": "boolean" }, { "type": "number" }, { "type": "string" },
        { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/portableValue" } },
        { "type": "object", "maxProperties": 128, "additionalProperties": { "$ref": "#/$defs/portableValue" } }
      ]
    }
  }
}
