{
  "manifestVersion": 1,
  "packageId": "first-party.fair-value-gap",
  "packageVersion": "1.0.0",
  "module": {
    "id": "optional.semantic-fair-value-gap",
    "version": "1.0.0"
  },
  "display": {
    "name": "Fair Value Gap",
    "description": "Strict evidence-derived three-Bar wick-gap semantics and projections."
  },
  "distribution": {
    "tier": "core",
    "source": "built-in",
    "publisherId": "first-party.replay-lab",
    "trust": "first-party"
  },
  "hostApiRange": "^1.0.0",
  "capabilities": {
    "provides": [
      { "id": "semantic.imbalance.fvg", "version": "1.0.0" },
      { "id": "construct.imbalance.fvg", "version": "1.0.0" }
