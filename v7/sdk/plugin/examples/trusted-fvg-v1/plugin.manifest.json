    "requires": [
      { "id": "annotation.evidence.bundle", "range": "^1.0.0" },
      { "id": "annotation.geometry.rectangle", "range": "^1.0.0" },
      { "id": "annotation.geometry.segment", "range": "^1.0.0" }
