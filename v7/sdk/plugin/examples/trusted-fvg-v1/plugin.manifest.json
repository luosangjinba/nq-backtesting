      "version": "1.0.0",
      "displayName": "Fair Value Gap",
      "parameters": {
        "schemaVersion": 1,
        "tabs": [
          { "id": "inputs", "source": { "kind": "inspector-groups", "groupIds": ["semantic"] } },
          { "id": "evidence", "source": { "kind": "inspector-groups", "groupIds": ["evidence"] } },
          { "id": "history", "source": { "kind": "inspector-groups", "groupIds": ["history"] } }
