{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://replay-lab.local/schemas/local-developer-evidence-receipt-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "evidenceKind", "contractProfile", "packageId", "packageVersion", "workspace", "receipts", "identities", "installableByItself", "activated", "publisherTrusted", "productionExecutionAuthorized", "digest"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "evidenceKind": { "const": "p1b-local-developer-evidence" },
    "contractProfile": { "const": "local-declarative-package-v1" },
    "packageId": { "$ref": "#/$defs/id" },
    "packageVersion": { "$ref": "#/$defs/version" },
    "workspace": { "$ref": "#/$defs/workspace" },
    "receipts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["build", "preview", "test"],
      "properties": {
        "build": { "$ref": "developer-kit-receipt-v2.schema.json" },
        "preview": { "$ref": "developer-kit-receipt-v2.schema.json" },
        "test": { "$ref": "developer-kit-receipt-v2.schema.json" }
      }
    },
    "identities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalogs", "operations", "schemas", "sdk", "toolchain"],
      "properties": {
        "catalogs": { "$ref": "#/$defs/digest" },
        "operations": { "$ref": "#/$defs/digest" },
        "schemas": { "$ref": "#/$defs/digest" },
        "sdk": { "$ref": "#/$defs/digest" },
        "toolchain": { "$ref": "#/$defs/digest" }
      }
    },
    "installableByItself": { "const": false },
    "activated": { "const": false },
    "publisherTrusted": { "const": false },
    "productionExecutionAuthorized": { "const": false },
    "digest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$", "maxLength": 128 },
    "version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expectedDigest", "fixtureDigest", "manifestDigest", "sourceDigest", "workspaceDigest"],
      "properties": {
        "expectedDigest": { "$ref": "#/$defs/digest" },
        "fixtureDigest": { "$ref": "#/$defs/digest" },
        "manifestDigest": { "$ref": "#/$defs/digest" },
        "sourceDigest": { "$ref": "#/$defs/digest" },
        "workspaceDigest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
