{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://replay-lab.local/schemas/developer-fixture-suite-v1.json",
  "title": "V7 Plugin Developer Fixture Suite V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "entrypointId", "cases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "entrypointId": { "$ref": "#/$defs/id" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "input"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "input": { "$ref": "synthetic-host-input-v1.schema.json" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,127}$" }
  }
}
