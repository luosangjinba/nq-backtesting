{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://replay-lab.local/schemas/developer-workspace-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "developerKitRange", "sdkRange", "contractProfile", "manifestPath", "sourceRoot", "entrypoints", "fixtureSuites", "expectedOutputs"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "developerKitRange": { "const": "^1.0.0" },
    "sdkRange": { "const": "^1.0.0" },
    "contractProfile": { "const": "local-declarative-package-v1" },
    "manifestPath": { "$ref": "#/$defs/path" },
    "sourceRoot": { "$ref": "#/$defs/path" },
    "entrypoints": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "kind", "path"],
        "properties": { "id": { "$ref": "#/$defs/id" }, "kind": { "const": "fixture-probe" }, "path": { "$ref": "#/$defs/path" } }
      }
    },
    "fixtureSuites": { "$ref": "#/$defs/pathRecords" },
    "expectedOutputs": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["fixtureSuiteId", "path"],
        "properties": { "fixtureSuiteId": { "$ref": "#/$defs/id" }, "path": { "$ref": "#/$defs/path" } }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,127}$" },
    "path": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[A-Za-z0-9._/-]+$", "maxLength": 240 },
    "pathRecords": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "path"],
        "properties": { "id": { "$ref": "#/$defs/id" }, "path": { "$ref": "#/$defs/path" } }
      }
    }
  }
}
