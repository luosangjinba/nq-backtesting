{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://replay-lab.local/schemas/developer-expected-output-suite-v1.json",
  "title": "V7 Plugin Developer Expected Output Suite V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "fixtureSuiteId", "cases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "fixtureSuiteId": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,127}$" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "output"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9.-]{0,127}$" },
          "output": { "$ref": "synthetic-host-output-v1.schema.json" }
        }
      }
    }
  }
}
