{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://replay-lab.local/schemas/developer-diagnostic-v1.json",
  "title": "V7 Plugin Developer Diagnostic V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "severity", "phase", "message", "related"],
  "properties": {
    "code": { "type": "string", "pattern": "^V7DK_[A-Z0-9_]+$" },
    "severity": { "enum": ["error", "warning", "info"] },
    "phase": { "type": "string", "minLength": 1 },
    "message": { "type": "string", "minLength": 1 },
    "logicalPath": { "type": "string", "minLength": 1 },
    "jsonPointer": { "type": "string", "pattern": "^/" },
    "sourceSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line", "column"],
      "properties": {
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 }
      }
    },
    "related": { "type": "array", "items": {} },
    "suggestedFix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "description", "safeToAutomate"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "safeToAutomate": { "type": "boolean" }
      }
    }
  }
}
