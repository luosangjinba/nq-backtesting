<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>V3 K线查看器 - Lightweight Charts</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      background: #0a0e27;
      color: #e0e3eb;
      overflow: hidden;
    }

    #app {
      display: flex;
      flex-direction: column;
      height: 100vh;
      width: 100vw;
    }

    /* 顶部工具栏 */
    .toolbar {
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 12px 16px;
    background: #1e222d;
      border-bottom: 1px solid #2a2e39;
    }

    .toolbar-group {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .toolbar-label {
      font-size: 13px;
    color: #787b86;
      white-space: nowrap;
    }

    .toolbar input[type="text"],
    .toolbar select {
      padding: 6px 10px;
      background: #131722;
      border: 1px solid #2a2e39;
      border-radius: 4px;
      color: #e0e3eb;
      font-size: 13px;
      font-family: 'Courier New', monospace;
    }

    .toolbar input[type="text"] {
      width: 140px;
    }

    .toolbar select {
      width: 80px;
    }

    .toolbar button {
      padding: 6px 16px;
      background: #2962ff;
      border: none;
      border-radius: 4px;
      color: white;
      font-size: 13px;
      font-weight: 500;
      cursor: pointer;
      transition: background 0.2s;
    }

    .toolbar button:hover {
      background: #1e53e5;
    }

    .toolbar button:disabled {
      background: #2a2e39;
      color: #787b86;
      cursor: not-allowed;
    }

    #statusText {
      margin-left: auto;
      font-size: 12px;
      color: #787b86;
    }

    /* 图表容器 */
    #chart {
      flex: 1;
      position: relative;
      background: #131722;
    }

    /* 加载状态 */
    .loading-overlay {
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(19, 23, 34, 0.8);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 1000;
    }

    .loading-content {
      text-align: center;
    }

    .loading-spinner {
      width: 40px;
      height: 40px;
      border: 3px solid #2a2e39;
      border-top-color: #2962ff;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
      margin: 0 auto 12px;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .loading-text {
      font-size: 13px;
      color: #787b86;
    }

    /* 提示信息 */
    .hint {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      text-align: center;
      color: #787b86;
      font-size: 14px;
    }

    .hint-icon {
      font-size: 48px;
      margin-bottom: 12px;
      opacity: 0.5;
    }
  </style>
</head>
<body>
  <div id="app">
    <div class="toolbar">
      <div class="toolbar-group">
        <span class="toolbar-label">开始时间:</span>
     <input type="text" id="startInput" placeholder="2012-01-09 09:30" />
      </div>
      <div class="toolbar-group">
        <span class="toolbar-label">结束时间:</span>
        <input type="text" id="endInput" placeholder="2012-01-09 16:00" />
      </div>
      <div class="toolbar-group">
        <span class="toolbar-label">周期:</span>
        <select id="tfSelect">
      <option value="1">1m</option>
          <option value="5">5m</option>
          <option value="15">15m</option>
          <option value="60" selected>1H</option>
          <option value="240">4H</option>
        </select>
      </div>
      <button id="loadBtn">加载</button>
      <span id="statusText">就绪</span>
    </div>

    <div id="chart">
      <div class="hint" id="hint">
        <div class="hint-icon">📊</div>
        <div>输入时间范围，点击"加载"查看 K线图表</div>
      <div style="margin-top: 8px; font-size: 12px; color: #5a5e6b;">
          示例: 2012-01-09 09:30 至 2012-01-09 16:00
        </div>
      </div>
    </div>
  </div>

  <!-- Lightweight Charts -->
  <script src="https://unpkg.com/lightweight-charts@4.1.3/dist/lightweight-charts.standalone.production.js"></script>

  <script>
    // ================================================
    // 全局状态
    // ==================================
    const state = {
      chart: null,
      candlestickSeries: null,
      loading: false,
      priceLines: [], // 存储 Price Lines
      markers: [], // 存储 Markers
    };

    // ======================================
    // 配置
    // ===================================================
    const API_BASE = 'http://127.0.0.1:8765';

    // ==========================================================
    // 工具函数
    // ================================================

    /**
     * 显示/隐藏加载状态
     */
    function showLoading(show) {
      state.loading = show;

      let overlay = document.querySelector('.loading-overlay');
      if (show) {
        if (!overlay) {
          overlay = document.createElement('div');
          overlay.className = 'loading-overlay';
        overlay.innerHTML = `
          <div class="loading-content">
              <div class="loading-spinner"></div>
              <div class="loading-text">加载中...</div>
            </div>
          `;
          document.getElementById('chart').appendChild(overlay);
        }
      } else {
        if (overlay) {
          overlay.remove();
        }
      }
    }

    /**
     * 更新状态文本
     */
    function updateStatus(text, isError = false) {
      const statusEl = document.getElementById('statusText');
      statusEl.textContent = text;
      statusEl.style.color = isError ? '#ef5350' : '#787b86';
    }

    /**
     * 隐藏提示信息
   */
    function hideHint() {
      const hint = document.getElementById('hint');
      if (hint) {
        hint.style.display = 'none';
      }
    }

    // ======================================================
    // 图表初始化
    // ===============================================

    /**
     * 初始化 Lightweight Charts
     */
    function initChart() {
      const container = document.getElementById('chart');

      state.chart = LightweightCharts.createChart(container, {
        width: container.clientWidth,
        height: container.clientHeight,
        layout: {
          background: { color: '#131722' },
          textColor: '#d1d4dc',
        },
        grid: {
        vertLines: { color: '#1e222d' },
          horzLines: { color: '#1e222d' },
        },
        crosshair: {
          mode: LightweightCharts.CrosshairMode.Normal,
      },
        rightPriceScale: {
          borderColor: '#2a2e39',
        },
        timeScale: {
          borderColor: '#2a2e39',
          timeVisible: true,
          secondsVisible: false,
        },
      });

      state.candlestickSeries = state.chart.addCandlestickSeries({
      upColor: '#26a69a',
        downColor: '#ef5350',
      borderVisible: false,
        wickUpColor: '#26a69a',
        wickDownColor: '#ef5350',
      });

      // 响应式调整
      window.addEventListener('resize', () => {
        state.chart.applyOptions({
       width: container.clientWidth,
          height: container.clientHeight,
        });
      });

      console.log('✓ 图表初始化完成');
    }

    // ====================================================
    // 数据加载
    // ================================================

    /**
     * 加载 K线数据
     */
    async function loadKlineData() {
      const start = document.getElementById('startInput').value.trim();
      const end = document.getElementById('endInput').value.trim();
      const tf = document.getElementById('tfSelect').value;

      // 验证输入
      if (!start || !end) {
      alert('请输入开始和结束时间\n格式: 2012-01-09 09:30');
        return;
      }

      showLoading(true);
      updateStatus('加载 K线数据...');
      hideHint();

      try {
        // 构建 API URL
        const url = `${API_BASE}/v2/bars?start=${encodeURIComponent(start)}&end=${encodeURIComponent(end)}&tf=${tf}`;
        console.log('请求 URL:', url);

      // 发起请求
        const response = await fetch(url);
        if (!response.ok) {
          throw new Error(`HTTP ${response.status}: ${response.statusText}`);
        }

        const data = await response.json();
        console.log('API 响应:', data);

        // 检查响应格式
        if (!data.ok) {
          throw new Error(data.error || '未知错误');
        }

      const bars = data.result;
      if (!bars || bars.length === 0) {
          throw new Error('该时段无数据');
     }

        // 转换数据格式
        // v2 API 返回的 timestamp 是 Unix 时间戳（秒）
        // Lightweight Charts 需要 Unix 时间戳（秒）
        const candleData = bars.map(bar => ({
          time: bar.timestamp, // 直接使用秒级时间戳
          open: bar.open,
          high: bar.high,
          low: bar.low,
          close: bar.close,
        }));

        console.log('转换后的数据:', candleData.slice(0, 3));

        // 设置数据
        state.candlestickSeries.setData(candleData);

        // 自动缩放到合适的视图
        state.chart.timeScale().fitContent();

      updateStatus(`已加载 ${candleData.length} 根 K线 (${tf}m)`);
        console.log(`✓ 成功加载 ${candleData.length} 根 K线`);

      } catch (error) {
      console.error('加载失败:', error);
     updateStatus(`错误: ${error.message}`, true);
        alert(`加载失败: ${error.message}`);
      } finally {
        showLoading(false);
      }
    }

    // =========================================================
    // 事件监听
    // ===================================================

    /**
     * 初始化事件监听
     */
    function initEventListeners() {
      // 加载按钮
      document.getElementById('loadBtn').addEventListener('click', loadKlineData);

      // 回车键加载
      ['startInput', 'endInput'].forEach(id => {
        document.getElementById(id).addEventListener('keypress', (e) => {
          if (e.key === 'Enter') {
         loadKlineData();
          }
        });
      });

      // 周期选择变化时，如果已有数据则重新加载
    document.getElementById('tfSelect').addEventListener('change', () => {
        const start = document.getElementById('startInput').value.trim();
        const end = document.getElementById('endInput').value.trim();
        if (start && end) {
          loadKlineData();
        }
      });

      console.log('✓ 事件监听初始化完成');
    }

    // =============================================
    // 应用启动
    // ========================================================

    /**
     * 初始化应用
     */
    function init() {
    console.log('=== V3 K线查看器启动 ===');

      initChart();
      initEventListeners();

      updateStatus('就绪');
      console.log('✓ 应用初始化完成');
    }

    // 页面加载完成后初始化
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  </script>
</body>
</html>
