[Unit]
Description=V4 Static Web
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/leo/myworkspace/trading/backtesting/v4
Environment=V4_WEB_PORT=8001
EnvironmentFile=-/home/leo/myworkspace/trading/backtesting/v4/.env.local
ExecStart=/usr/bin/python3 -m http.server ${V4_WEB_PORT}
Restart=on-failure
RestartSec=3
User=leo
Group=leo

[Install]
WantedBy=multi-user.target
