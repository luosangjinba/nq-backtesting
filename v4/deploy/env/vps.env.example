# V4 VPS reverse-proxy mode example.
# Copy selected values into v4/.env.local on the server.

# Public HTTPS domain handled by Caddy.
V4_PUBLIC_DOMAIN=your-domain.example

# Optional email for ACME certificate registration.
V4_ACME_EMAIL=

# Optional Caddy Basic Auth credentials for public HTTPS deployments.
# Generate the hash on the VPS with:
#   caddy hash-password --plaintext 'your-strong-password'
# Pass the values to install_reverse_proxy.sh with:
#   --basic-auth-user USER --basic-auth-hash HASH
V4_BASIC_AUTH_USER=
V4_BASIC_AUTH_HASH=

# Keep internal services private. Caddy is the public entry point.
V4_API_HOST=127.0.0.1
V4_WEB_HOST=127.0.0.1
V4_WEB_PORT=8001

# Browser origin allowed to send protected workspace/maintenance writes.
V4_ALLOWED_WEB_ORIGINS=https://your-domain.example

# Choose the canonical server DB path.
# Repo-local is acceptable for early single-user VPS tests.
V4_TRADING_DB=/home/leo/myworkspace/trading/backtesting/v4/data/trading_data.duckdb

# Required for Databento-backed refresh actions.
DATABENTO_API_KEY=
